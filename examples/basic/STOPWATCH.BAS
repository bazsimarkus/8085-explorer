10 REM === COUNTDOWN TIMER ===
20 PRINT "COUNTDOWN TIMER"
30 PRINT "==============="
40 INPUT "SECONDS TO COUNT";SC
50 PRINT "COUNTING..."
60 FOR S=1 TO SC
70 FOR D=1 TO 829
80 NEXT D
90 NEXT S
100 PRINT "TIME!"
110 PRINT SC;"SECONDS ELAPSED."
120 PRINT
130 INPUT "AGAIN (1=YES 0=NO)";A
140 IF A=1 THEN GOTO 40
150 END