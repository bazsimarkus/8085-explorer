10 REM === TIC-TAC-TOE ===
20 DIM B(9):P=1
30 FOR I=1 TO 9:B(I)=0:NEXT
40 REM --- Draw Board ---
50 PRINT
60 FOR R=0 TO 2
70 PRINT " ";
80 FOR I=1 TO 3
90 C=R*3+I
100 IF B(C)=0 THEN PRINT " ";MID$(STR$(C),2);" ";
110 IF B(C)=1 THEN PRINT " X ";
120 IF B(C)=2 THEN PRINT " O ";
130 IF I<3 THEN PRINT "|";
140 NEXT I:PRINT
150 IF R<2 THEN PRINT " ---+---+---"
160 NEXT R
170 PRINT
180 REM --- Check Winner ---
190 FOR W=1 TO 2
200 IF B(1)=W AND B(2)=W AND B(3)=W THEN 500
210 IF B(4)=W AND B(5)=W AND B(6)=W THEN 500
220 IF B(7)=W AND B(8)=W AND B(9)=W THEN 500
230 IF B(1)=W AND B(4)=W AND B(7)=W THEN 500
240 IF B(2)=W AND B(5)=W AND B(8)=W THEN 500
250 IF B(3)=W AND B(6)=W AND B(9)=W THEN 500
260 IF B(1)=W AND B(5)=W AND B(9)=W THEN 500
270 IF B(3)=W AND B(5)=W AND B(7)=W THEN 500
280 NEXT W
290 REM --- Check Draw ---
300 D=1:FOR I=1 TO 9:IF B(I)=0 THEN D=0
310 NEXT:IF D=1 THEN PRINT "It's a DRAW!":END
320 REM --- Get Move ---
330 IF P=1 THEN PRINT "Player X";
340 IF P=2 THEN PRINT "Player O";
350 PRINT ", pick square (1-9)";:INPUT M
360 IF M<1 OR M>9 THEN PRINT "Bad square!":GOTO 330
370 IF B(M)<>0 THEN PRINT "Taken!":GOTO 330
380 B(M)=P:P=3-P:GOTO 50
500 IF W=1 THEN PRINT "*** X WINS! ***":END
510 PRINT "*** O WINS! ***":END