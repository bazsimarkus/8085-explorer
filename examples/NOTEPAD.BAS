10 CLEAR 200,28671
20 REM === NOTEPAD WITH RAMDISK STORAGE ===
30 REM Single-script Notepad app with RAMDISK for the 8085-explorer
40 REM Magic bytes: 170,85 = formatted
50 BD=28672:DA=28928:DE=32767
60 IF PEEK(BD)=170 AND PEEK(BD+1)=85 THEN 90
70 PRINT "Formatting RAMDISK..."
75 FOR I=BD TO BD+255:POKE I,0:NEXT I
80 POKE BD,170:POKE BD+1,85
90 DIM L$(50):NL=0
100 PRINT
110 PRINT "=== NOTEPAD v3.0 ==="
120 PRINT "(A)dd  (L)ist  (E)dit  (R)emove"
130 PRINT "(S)ave (O)pen  (D)ir   (K)ill"
140 PRINT "(N)ew  (Q)uit"
150 PRINT ">";
160 INPUT C$
170 IF C$="A" OR C$="a" THEN 1000
180 IF C$="L" OR C$="l" THEN 2000
190 IF C$="E" OR C$="e" THEN 2500
200 IF C$="R" OR C$="r" THEN 2800
210 IF C$="S" OR C$="s" THEN 3000
220 IF C$="O" OR C$="o" THEN 4000
230 IF C$="D" OR C$="d" THEN 5000
240 IF C$="K" OR C$="k" THEN 6000
250 IF C$="N" OR C$="n" THEN 7000
260 IF C$="Q" OR C$="q" THEN 8000
270 GOTO 100
1000 REM --- ADD LINES ---
1010 PRINT "Line (blank=done):";
1020 INPUT T$
1030 IF T$="" THEN 100
1040 NL=NL+1:L$(NL)=T$
1050 PRINT "[";NL;"]"
1060 GOTO 1010
2000 REM --- LIST ---
2010 IF NL=0 THEN PRINT "Empty.":GOTO 100
2020 FOR I=1 TO NL
2030 PRINT I;": ";L$(I)
2040 NEXT I
2050 GOTO 100
2500 REM --- EDIT LINE ---
2510 IF NL=0 THEN PRINT "Empty.":GOTO 100
2520 PRINT "Edit line # (1-";NL;"):";
2530 INPUT EN
2540 IF EN<1 OR EN>NL THEN PRINT "Bad #":GOTO 100
2550 PRINT "Old: ";L$(EN)
2560 PRINT "New:";
2570 INPUT T$
2580 IF T$="" THEN PRINT "No change.":GOTO 100
2590 L$(EN)=T$
2600 PRINT "Updated line";EN
2610 GOTO 100
2800 REM --- REMOVE LINE ---
2810 IF NL=0 THEN PRINT "Empty.":GOTO 100
2820 PRINT "Remove # (1-";NL;"):";
2830 INPUT EN
2840 IF EN<1 OR EN>NL THEN PRINT "Bad #":GOTO 100
2850 PRINT "Del: ";L$(EN)
2860 FOR I=EN TO NL-1
2870 L$(I)=L$(I+1)
2880 NEXT I
2890 L$(NL)="":NL=NL-1
2900 PRINT "Done.";NL;"lines left."
2910 GOTO 100
3000 REM --- SAVE TO RAMDISK ---
3010 PRINT "Filename (max 8):";
3020 INPUT F$
3030 IF F$="" THEN 100
3040 IF LEN(F$)>8 THEN F$=LEFT$(F$,8)
3050 IF NL=0 THEN PRINT "Nothing!":GOTO 100
3060 IF LEN(F$)<8 THEN F$=F$+"        ":F$=LEFT$(F$,8)
3070 NF=PEEK(BD+2)
3080 IF NF>=8 THEN PRINT "DISK FULL":GOTO 100
3090 IF NF=0 THEN SA=DA:GOTO 3120
3100 LP=BD+3+(NF-1)*12
3110 SA=PEEK(LP+8)*256+PEEK(LP+9)+PEEK(LP+10)*256+PEEK(LP+11)
3120 SZ=0
3130 FOR I=1 TO NL
3140 SZ=SZ+1+LEN(L$(I))
3150 NEXT I
3160 SZ=SZ+1
3170 IF SA+SZ>DE THEN PRINT "NO SPACE!":GOTO 100
3180 P=SA
3190 FOR I=1 TO NL
3200 POKE P,LEN(L$(I)):P=P+1
3210 FOR J=1 TO LEN(L$(I))
3220 POKE P,ASC(MID$(L$(I),J,1)):P=P+1
3230 NEXT J
3240 NEXT I
3250 POKE P,255
3260 FP=BD+3+NF*12
3270 FOR I=1 TO 8
3280 POKE FP+I-1,ASC(MID$(F$,I,1))
3290 NEXT I
3300 POKE FP+8,INT(SA/256)
3310 POKE FP+9,SA-INT(SA/256)*256
3320 LN=P-SA+1
3330 POKE FP+10,INT(LN/256)
3340 POKE FP+11,LN-INT(LN/256)*256
3350 POKE BD+2,NF+1
3360 PRINT "SAVED '";F$;"'";LN;"B"
3370 GOTO 100
4000 REM --- OPEN FROM RAMDISK ---
4010 PRINT "Filename:";
4020 INPUT F$
4030 IF F$="" THEN 100
4040 IF LEN(F$)>8 THEN F$=LEFT$(F$,8)
4050 IF LEN(F$)<8 THEN F$=F$+"        ":F$=LEFT$(F$,8)
4060 NF=PEEK(BD+2)
4070 IF NF=0 THEN PRINT "NO FILES.":GOTO 100
4080 FD=0
4090 FOR I=0 TO NF-1
4100 FP=BD+3+I*12:N$=""
4110 FOR J=0 TO 7
4120 N$=N$+CHR$(PEEK(FP+J))
4130 NEXT J
4140 IF N$=F$ THEN FD=1:I=NF-1
4150 NEXT I
4160 IF FD=0 THEN PRINT "NOT FOUND.":GOTO 100
4170 SA=PEEK(FP+8)*256+PEEK(FP+9)
4180 NL=0:P=SA
4190 LB=PEEK(P)
4200 IF LB=255 THEN 4260
4210 NL=NL+1:L$(NL)=""
4220 IF LB=0 THEN P=P+1:GOTO 4190
4230 FOR J=1 TO LB
4240 L$(NL)=L$(NL)+CHR$(PEEK(P+J))
4250 NEXT J
4255 P=P+LB+1:GOTO 4190
4260 PRINT "LOADED '";F$;"'";NL;"lines"
4270 GOTO 100
5000 REM --- DIRECTORY ---
5010 NF=PEEK(BD+2)
5020 IF NF=0 THEN PRINT "NO FILES.":GOTO 100
5030 PRINT "--- RAMDISK ---"
5040 FOR I=0 TO NF-1
5050 FP=BD+3+I*12:N$=""
5060 FOR J=0 TO 7
5070 N$=N$+CHR$(PEEK(FP+J))
5080 NEXT J
5090 SZ=PEEK(FP+10)*256+PEEK(FP+11)
5100 PRINT N$;" ";SZ;"B"
5110 NEXT I
5120 LP=BD+3+(NF-1)*12
5130 US=PEEK(LP+8)*256+PEEK(LP+9)+PEEK(LP+10)*256+PEEK(LP+11)
5140 PRINT "Free:";DE-US;"B"
5150 GOTO 100
6000 REM --- KILL FILE ---
6010 NF=PEEK(BD+2)
6020 IF NF=0 THEN PRINT "NO FILES.":GOTO 100
6030 PRINT "Kill last file? (Y/N):";
6040 INPUT Y$
6050 IF Y$<>"Y" AND Y$<>"y" THEN 100
6060 POKE BD+2,NF-1
6070 PRINT "Killed."
6080 GOTO 100
7000 REM --- NEW (CLEAR BUFFER) ---
7010 NL=0
7020 PRINT "Buffer cleared."
7030 GOTO 100
8000 REM --- QUIT ---
8010 PRINT "Goodbye!"
8020 END
